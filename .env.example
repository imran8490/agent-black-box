# Copy to .env.local and fill in. This project runs on Sui MAINNET + Walrus MAINNET.
# It spends small amounts of real SUI and WAL. Run `npm run check:mainnet` before your first run.

# --- Sui mainnet via Tatum (required) ---
SUI_NETWORK=mainnet
NEXT_PUBLIC_SUI_NETWORK=mainnet
# Free key from https://dashboard.tatum.io. All Sui RPC calls go through Tatum's gateway:
# https://sui-mainnet-grpc.gateway.tatum.io (gRPC, default) or https://sui-mainnet.gateway.tatum.io (JSON-RPC).
TATUM_API_KEY=
# "grpc" (default, native gRPC), "jsonrpc" (safe fallback) or "grpcweb". `npm run check:rpc` tells you which one your key can reach.
SUI_RPC_MODE=grpc
# Optional override. Leave empty to use the Tatum endpoint.
SUI_RPC_URL=
# Package id printed by `npm run move:publish` (publish on MAINNET).
PACKAGE_ID=
# The agent's wallet key (suiprivkey1...). Use a DEDICATED mainnet wallet holding only a few SUI and a little WAL.
SUI_PRIVATE_KEY=

# --- Walrus mainnet ---
# Mainnet has no public publisher, so uploads go through @mysten/walrus and the upload relay.
# The agent wallet pays storage in WAL and the relay tip in SUI.
WALRUS_UPLOAD_RELAY_URL=https://upload-relay.mainnet.walrus.space
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-mainnet.walrus.space
NEXT_PUBLIC_WALRUS_AGGREGATOR_URL=https://aggregator.walrus-mainnet.walrus.space
# Max tip (MIST) the relay may charge per upload. 5000000 = 0.005 SUI.
WALRUS_RELAY_MAX_TIP_MIST=5000000
# Mainnet epoch is about 2 weeks, so 10 epochs is about 20 weeks of storage.
WALRUS_EPOCHS=10
# Walrus SDK internal reads use a public fullnode (free Tatum keys return 429 on its many calls). Payment + record tx + verify still use Tatum.
# WALRUS_VIA_TATUM=1
# WALRUS_SUI_RPC_URL=https://fullnode.mainnet.sui.io:443

# --- Walrus Memory / MemWal on mainnet (required) ---
# Every decision is saved twice (full log + recall summary), so 5 runs = 10 memories.
MEMWAL_ACCOUNT_ID=       # your MemWalAccount object id on Sui MAINNET
MEMWAL_DELEGATE_KEY=     # delegate Ed25519 key (hex or suiprivkey1...). Keep it only in .env.local
# MEMWAL_SERVER_URL=     # default https://relayer.memory.walrus.xyz
# MEMWAL_NAMESPACE=black-box

# --- Agent (fill ONE key; with none, a scripted agent runs and the UI labels it) ---
# AGENT_PROVIDER=gemini   # optional: force "anthropic" | "gemini" | "openai" | "scripted"
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: Gemini overloaded (503)? Calls retry 4x automatically; set a second model to fall back to.
# GEMINI_FALLBACK_MODEL=
# Any OpenAI-compatible gateway (OpenRouter, Bluesminds, LiteLLM...). Set AGENT_PROVIDER=openai to force it.
# OPENAI_BASE_URL=https://api.bluesminds.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=
# Set to 1 to force the scripted agent even if a key is present.
SIMULATE_AGENT=0
# "standard" (default) or "naive" (follows payment updates found in documents; injection works far more often).
AGENT_PROMPT=standard
# Walrus Memory guard switches. MEMORY_GUARD=off: never consult old memories. MEMORY_IGNORE_ADDRESSES: comma list of
# addresses old memories may never flag. New decisions are always still remembered.
# MEMORY_GUARD=off
# MEMORY_IGNORE_ADDRESSES=0x...

# --- Demo wallets (make the demo real) ---
# Two wallets YOU control: the vendor gets the honest payment, the attacker gets the stolen funds when the
# guard is OFF. Defaults are unowned addresses (funds sent there are lost).
# VENDOR_ADDRESS=0x...
# ATTACKER_ADDRESS=0x...
# Where this app runs. The agent fetches the invoice pages from here over HTTP.
APP_BASE_URL=http://localhost:3000

# --- Black Box policy ---
# Largest single payment the agent may make, in SUI.
MAX_PAYMENT_SUI=0.02
# Amount the hijacked invoice tries to steal. REAL money on mainnet, sent only when the guard is OFF.
ATTACK_AMOUNT_SUI=0.05

# The dashboard's Run buttons spend real money from the server wallet. Keep false on any public deployment.
DEMO_RUN_ENABLED=true

# --- Development escape hatches (leave unset for the real demo) ---
# ALLOW_NON_MAINNET=1
# MEMWAL_OPTIONAL=1
